# ==========================================================
# RESEARCHVERSE AI - ENVIRONMENT CONFIGURATION
# ==========================================================

# Database: Neon Serverless PostgreSQL
# Format: postgresql+asyncpg://<user>:<password>@<ep-xyz>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?ssl=require
# Sync fallback for Alembic migrations if needed:
DATABASE_URL_SYNC=postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# App Security
SECRET_KEY=super-secret-key-change-this-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider API Keys (Isi salah satu atau keduanya untuk gratis)
# 1. Google Gemini (Google AI Studio - 100% Free): https://aistudio.google.com
GEMINI_API_KEY=
# 2. Groq Cloud (Super Fast LPU - 100% Free): https://console.groq.com
GROQ_API_KEY=
# 3. Optional: OpenAI / OpenRouter API Key
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Academic Search APIs (100% Free, No API Key Required)
OPENALEX_MAILTO=researcher@researchverse.ai
CROSSREF_MAILTO=researcher@researchverse.ai
SEMANTIC_SCHOLAR_API_KEY=

# Frontend & CORS
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
