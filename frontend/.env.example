# Google Gemini (Google AI Studio): https://aistudio.google.com
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# 3. Academic APIs (Opsional / Polite Pool)
OPENALEX_MAILTO=researcher@researchverse.ai
CROSSREF_MAILTO=researcher@researchverse.ai
